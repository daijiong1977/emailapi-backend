# Email API Configuration Example
# Copy this file to .env and fill in your credentials

# Mail configuration file path (optional)
# The app will use this JSON file for mail provider settings
# Fallback to environment variables if not present
MAIL_CONFIG_PATH=./mail_config.json

# Mail provider: gmail or ses (default: gmail)
MAIL_PROVIDER=gmail

# Sender email address (optional for Gmail, required for SES)
MAIL_FROM=

# Gmail SMTP Configuration
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# AWS SES Configuration (only needed if using SES provider)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Admin and API Configuration
ADMIN_TOKEN=your-admin-token-here
REG_TOKEN=your-registration-token-here
PANEL_PASSWORD=771008

# API Keys Database
API_KEYS_DB=./api_keys.db

# Device Configuration
DEVICE_USERNAME_PREFIX=ios
DEVICE_ID_MIN_LENGTH=16

# Domain Filtering (comma-separated)
# Leave ALLOW_DOMAINS empty to allow all domains
ALLOW_DOMAINS=
BLOCK_DOMAINS=

# Environment file path
ENV_FILE_PATH=.env
